# Configuration file for AI Exchange
# Copy this to .env in production and update values

# Flask Configuration
SECRET_KEY=change-this-to-a-secure-random-string-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Admin Configuration  
ADMIN_PASSWORD=admin123

# Database Configuration
DATABASE_URL=sqlite:///database.db

# Supabase Configuration (uncomment and fill these to use Supabase instead of SQLite)
# USE_SUPABASE=true
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Stack Builder Configuration
GROQ_API_KEY=your-groq-api-key-here

# External API Configuration

# Server Configuration
HOST=127.0.0.1
PORT=5000

# File Upload Configuration
UPLOAD_FOLDER=static/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB max file size

# Security Configuration
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
PERMANENT_SESSION_LIFETIME=3600  # 1 hour in seconds

# Application Settings
TOOLS_PER_PAGE=12
COMMENTS_PER_PAGE=10
RATINGS_PER_PAGE=10

# XP Rewards
XP_RATING=20
XP_COMMENT=30
XP_TOOL_SUBMISSION=100

# Email Configuration (for future use)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
